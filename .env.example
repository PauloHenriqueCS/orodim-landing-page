# Copy to .env (local dev with `vercel dev`) and/or set as a Vercel
# Environment Variable (Project Settings → Environment Variables). Never
# commit the real value or expose it to the browser.

# Resend API key used by /api/contact.js to send the contact form email.
# The sending domain used in the "from" address (no-reply@lemonenglish.app,
# see api/contact.js) must be added and verified in the Resend dashboard
# (Domains → Add Domain → add the DNS records) before emails will deliver.
RESEND_API_KEY=
